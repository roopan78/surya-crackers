# Server
PORT=4000
NODE_ENV=development

# PostgreSQL connection string consumed by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/surya_crackers?schema=public"

# Angular dev server origin(s), comma-separated
CORS_ORIGIN="http://localhost:4200"

# JWT
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="1d"

# RBAC — this email is auto-promoted to SUPER_ADMIN on signup/login
SUPER_ADMIN_EMAIL="you@example.com"

# Google Sign-In — OAuth 2.0 "Web application" client ID from Google Cloud Console
GOOGLE_CLIENT_ID=""

# Direct UPI payments (dynamic QR + UTR verification). Leave BUSINESS_VPA empty
# to hide the UPI payment option from checkout.
BUSINESS_VPA="suryacrackers@ibl"
BUSINESS_NAME="Surya Crackers"

# WhatsApp Business Cloud API (Meta). Leave ACCESS_TOKEN/PHONE_NUMBER_ID empty
# to disable sending — notifications are then recorded as SKIPPED, never sent.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
# Any random string; must match what you enter in Meta's webhook setup form
WHATSAPP_VERIFY_TOKEN=""
# Meta App Secret (App Dashboard > Settings > Basic). When set, every webhook
# POST must carry a valid X-Hub-Signature-256 or it is rejected with 403.
WHATSAPP_APP_SECRET=""
# Meta-approved template NAMES (see docs/whatsapp-templates.md for the bodies)
WHATSAPP_TEMPLATE_ORDER_SUCCESS="order_confirmation"
WHATSAPP_TEMPLATE_ORDER_FAILED="order_failed"
WHATSAPP_TEMPLATE_LANGUAGE="en"

# PhonePe — merchant KYC pending, keep PHONEPE_ENABLED=false until approved
PHONEPE_ENABLED="false"
PHONEPE_ENV="SANDBOX"
PHONEPE_MERCHANT_ID=""
PHONEPE_SALT_KEY=""
PHONEPE_SALT_INDEX="1"
