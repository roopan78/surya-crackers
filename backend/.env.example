# Server
PORT=4000
NODE_ENV=development

# PostgreSQL connection string consumed by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/surya_crackers?schema=public"

# Angular dev server origin(s), comma-separated
CORS_ORIGIN="http://localhost:4200"

# JWT
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="1d"

# RBAC — this mobile number is auto-promoted to SUPER_ADMIN on first OTP login
SUPER_ADMIN_MOBILE="918610930273"

# OTP — "mock" logs the code to the server console and echoes it in the API
# response outside production; swap in a real vendor here once chosen.
OTP_PROVIDER="mock"
OTP_EXPIRY_MINUTES="5"

# PhonePe — merchant KYC pending, keep PHONEPE_ENABLED=false until approved
PHONEPE_ENABLED="false"
PHONEPE_ENV="SANDBOX"
PHONEPE_MERCHANT_ID=""
PHONEPE_SALT_KEY=""
PHONEPE_SALT_INDEX="1"
