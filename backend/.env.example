# Server
PORT=4000
NODE_ENV=development

# PostgreSQL connection string consumed by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/surya_crackers?schema=public"

# Angular dev server origin(s), comma-separated
CORS_ORIGIN="http://localhost:4200"

# JWT
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="1d"

# RBAC — this email is auto-promoted to SUPER_ADMIN on signup/login
SUPER_ADMIN_EMAIL="you@example.com"

# Google Sign-In — OAuth 2.0 "Web application" client ID from Google Cloud Console
GOOGLE_CLIENT_ID=""

# WhatsApp Business Cloud API (Meta). Leave ACCESS_TOKEN/PHONE_NUMBER_ID empty
# to disable sending — notifications are then recorded as SKIPPED, never sent.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
# Any random string; must match what you enter in Meta's webhook setup form
WHATSAPP_VERIFY_TOKEN=""
# Meta App Secret (App Dashboard > Settings > Basic). When set, every webhook
# POST must carry a valid X-Hub-Signature-256 or it is rejected with 403.
WHATSAPP_APP_SECRET=""
# Meta-approved template NAMES (see docs/whatsapp-templates.md for the bodies)
WHATSAPP_TEMPLATE_ORDER_SUCCESS="order_confirmation"
WHATSAPP_TEMPLATE_ORDER_FAILED="order_failed"
WHATSAPP_TEMPLATE_LANGUAGE="en"

# Outbound email (SMTP) — transactional account mail. Today this sends the
# temporary password to accounts created through Google Sign-In. Leave
# SMTP_HOST/USER/PASSWORD empty to disable: no mail is sent and no temporary
# password is set, so nobody ends up with a credential they never received.
# Gmail/Workspace: smtp.gmail.com:587, SMTP_SECURE=false, and an App Password
# (not the account password) — https://myaccount.google.com/apppasswords
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Surya Crackers <no-reply@suryacrackers.shop>"

# ZeptoMail (Zoho's transactional service) over HTTPS. Preferred over SMTP
# whenever the token is set — and necessary on hosts that block outbound SMTP,
# which is why production uses it: Railway cannot reach smtp.zoho.in on 587 or
# 465, both time out. Token: ZeptoMail > Mail Agents > your agent > Setup Info.
# Needs a verified domain on the ZeptoMail account.
ZEPTOMAIL_TOKEN=""
# .com for most accounts, .in for India-hosted ones — the agent page says which.
ZEPTOMAIL_API_URL="https://api.zeptomail.com/v1.1/email"

# Zoho Mail API — sends through an ordinary Zoho mailbox over HTTPS, needing no
# extra product and no SMTP port. Takes precedence over both options above when
# all three OAuth values are set. Create a Self Client at api-console.zoho.in,
# generate a code for scope ZohoMail.messages.CREATE,ZohoMail.accounts.READ, and
# exchange it once for a refresh token (returned only on that first exchange).
ZOHO_MAIL_CLIENT_ID=""
ZOHO_MAIL_CLIENT_SECRET=""
ZOHO_MAIL_REFRESH_TOKEN=""
# Must be an address the mailbox owns, or Zoho rejects the send.
ZOHO_MAIL_FROM="info@suryacrackers.shop"
# Data-centre hosts — India accounts use .in, most others .com.
ZOHO_ACCOUNTS_HOST="https://accounts.zoho.in"
ZOHO_MAIL_API_HOST="https://mail.zoho.in"

# Cloudinary (product images). Dashboard > Settings > API Keys.
# Empty values disable admin image uploads; the manual URL field keeps working.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="surya-crackers"

# PhonePe — merchant KYC pending, keep PHONEPE_ENABLED=false until approved
PHONEPE_ENABLED="false"
PHONEPE_ENV="SANDBOX"
PHONEPE_MERCHANT_ID=""
PHONEPE_SALT_KEY=""
PHONEPE_SALT_INDEX="1"

# IndexNow (Bing/Yandex instant indexing). Must equal the <key>.txt filename
# served from the site root. Empty disables submission.
INDEXNOW_KEY="4bac406171bd36c42fb2c56e2bbc481e"

# Where the staff Android APK is kept. Unset locally means .storage/app-release
# in the repo; in production it points at the mounted Railway volume.
APP_RELEASE_DIR=

# Optional. A long random secret (32+ chars) that lets a build machine or a CI
# job publish an APK without a signed-in browser session. Accepted only on
# POST /api/admin/app-release. Leave blank to keep publishing session-only.
#   openssl rand -base64 48
APP_RELEASE_TOKEN=
