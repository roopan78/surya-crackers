# Server
PORT=4000
NODE_ENV=development

# PostgreSQL connection string consumed by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/surya_crackers?schema=public"

# Angular dev server origin(s), comma-separated
CORS_ORIGIN="http://localhost:4200"

# JWT
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="1d"

# Seed script (initial admin account)
ADMIN_SEED_USERNAME="admin"
ADMIN_SEED_PASSWORD="ChangeMe123!"
