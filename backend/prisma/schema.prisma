generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  PENDING
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AWAITING_VERIFICATION
  PAID
  FAILED
  REFUNDED
}

enum PaymentProviderType {
  PHONEPE
  CASH_ON_PICKUP
  UPI_DIRECT
}

// Delivery channels a customer notification can go out on. Only WHATSAPP is
// implemented; SMS/EMAIL/PUSH are here so adding a channel is a provider +
// enum value, not a schema migration of the log table.
enum NotificationChannelType {
  WHATSAPP
  SMS
  EMAIL
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED
}

model User {
  id String @id @default(cuid())

  email String @unique
  // Null for Google-only accounts, which have no local password to check.
  passwordHash String?
  // Google's stable subject claim; null until/unless the account links Google.
  googleId String? @unique

  name      String?
  mobile    String?
  role      Role     @default(CUSTOMER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders OrderLedger[]

  @@index([role])
  @@map("users")
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imagePath   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@map("categories")
}

model Product {
  id                 String   @id @default(cuid())
  name               String
  sku                String   @unique
  slug               String   @unique
  categoryId         String
  price              Decimal  @db.Decimal(10, 2)
  // Pre-discount / MRP price. Null when the product is not discounted; the UI
  // only strikes it through when it is genuinely higher than `price`.
  originalPrice      Decimal? @db.Decimal(10, 2)
  boxQuantity        String
  imageUrls          String[]
  videoUrl           String?
  safetyInstructions String
  isFeatured         Boolean  @default(false)
  isActive           Boolean  @default(true)
  stockCount         Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId])
  @@index([isFeatured])
  @@index([isActive])
  @@map("products")
}

model CarouselBanner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("carousel_banners")
}

// Singleton row: application code always reads/writes the record where id = 1.
model FooterConfig {
  id               Int      @id @default(1)
  shopName         String
  licenseNumber    String
  phone            String
  whatsappNumber   String
  // Social profile links — empty string means "not configured", the storefront hides the icon
  instagramUrl     String   @default("")
  facebookUrl      String   @default("")
  safetyDisclaimer String
  updatedAt        DateTime @updatedAt

  @@map("footer_config")
}

/// One shop location. Every entry is listed in the storefront footer; exactly
/// one is flagged `isPrimary` and that is the address published in the
/// LocalBusiness structured data, which accepts a single location.
model ShopAddress {
  id        String   @id @default(cuid())
  address   String
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@map("shop_addresses")
}

model OrderLedger {
  id               String              @id @default(cuid())
  orderNumber      String              @unique
  customerId       String?
  guestName        String?
  guestMobile      String?
  pickupDate       DateTime?
  pickupTime       String?
  notes            String?
  items            Json
  estimatedTotal   Decimal             @db.Decimal(10, 2)
  status           OrderStatus         @default(PENDING)
  paymentStatus    PaymentStatus       @default(PENDING)
  paymentProvider  PaymentProviderType
  paymentReference String?
  // 12-digit UPI transaction reference the customer submits after paying (UPI_DIRECT only)
  utrNumber        String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  customer      User?             @relation(fields: [customerId], references: [id])
  notifications NotificationLog[]

  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([customerId])
  @@map("order_ledger")
}

/// One row per notification attempt. Doubles as the duplicate guard: the
/// unique (orderId, event, channel) index is claimed before the provider call,
/// so a retried request can never send the same message twice.
model NotificationLog {
  id      String  @id @default(cuid())
  orderId String?
  // Kept denormalized so failure notifications (which have no order row yet)
  // are still traceable to the order number the customer was quoted.
  orderNumber String?

  event        String
  channel      NotificationChannelType @default(WHATSAPP)
  templateName String
  recipient    String

  status            NotificationStatus @default(PENDING)
  providerMessageId String?
  failureReason     String?
  attempts          Int                @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order OrderLedger? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([orderId, event, channel])
  @@index([status])
  @@index([orderNumber])
  @@index([providerMessageId])
  @@map("notification_log")
}
