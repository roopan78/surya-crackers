{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/frontend/browser",
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "https://api.suryacrackers.shop/sitemap.xml" },
    { "source": "/image-sitemap.xml", "destination": "https://api.suryacrackers.shop/image-sitemap.xml" },
    { "source": "/feed.xml", "destination": "https://api.suryacrackers.shop/feed.xml" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
